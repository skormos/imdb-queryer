# Copy to .env (which is gitignored) to override the defaults.

# Host port for Postgres. Defaults to 5433 so it doesn't clash with other databases on 5432.
IMDB_DB_PORT=5433

# Host port for pgAdmin (http://localhost:8888).
PGADMIN_PORT=8888

# Set to true to keep the parsed TSVs (~6 GB) after a successful load.
# Downloads are always kept.
KEEP_PARSED=false
